# ============================================================
# 课程作品集仓库 .gitignore
# 作用：告诉 Git「这些文件不要纳入版本管理」
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/
ENV/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- C / C++ (课程常用) ----------
*.o
*.obj
*.exe
*.out
*.a
*.lib
*.dll
*.class

# ---------- Node.js (若课程涉及前端) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.cache/

# ---------- 数据与实验产物 ----------
# 大体积数据集、临时输出、生成的结果文件
data/raw/
*.csv.bak
*.tmp
*.temp
outputs/
results/tmp/
*.log

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 密钥与隐私（务必不要上传） ----------
.env
.env.local
*.key
*.pem
secrets.json
credentials.json

# ---------- 其他 ----------
*.bak
*.orig
